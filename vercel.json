{
  "version": 2,
  "builds": [
    {
      "src": "server.py",
      "use": "@vercel/python"
    },
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/regimes/(.*)",
      "dest": "server.py"
    },
    {
      "src": "/accuracy/(.*)",
      "dest": "server.py"
    },
    {
      "src": "/model/(.*)",
      "dest": "server.py"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/$1"
    }
  ]
}
